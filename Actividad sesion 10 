    {
      "cell_type": "markdown",
      "source": [
        "Codigo app simulacion maquinas de soporte vectorial:\n",
        "\n",
        "\n",
        "import React, { useState, useMemo } from 'react';\n",
        "import { HousingRecord, SvmConfig, SupportVectorInfo } from './types/housing';\n",
        "import { DEFAULT_DATASET, FEATURES } from './data/housingDataset';\n",
        "import { prepare2DData, prepare3DData } from './utils/dataProcessing';\n",
        "import { trainSVM2D, trainSVM3D } from './utils/svmSolver';\n",
        "import { SvmVisualizer2D } from './components/SvmVisualizer2D';\n",
        "import { SvmVisualizer3D } from './components/SvmVisualizer3D';\n",
        "import { ControlsPanel } from './components/ControlsPanel';\n",
        "import { PedagogicalGuide } from './components/PedagogicalGuide';\n",
        "import { ManualChallenge } from './components/ManualChallenge';\n",
        "import { PointInspector } from './components/PointInspector';\n",
        "import { Compass, Box, Trophy, BookOpen, Layers, Sparkles, Building2, HelpCircle } from 'lucide-react';\n",
        "\n",
        "export default function App() {\n",
        "  // Navigation mode\n",
        "  const [activeTab, setActiveTab] = useState<'sim2d' | 'sim3d' | 'challenge' | 'pedagogy'>('sim2d');\n",
        "\n",
        "  // SVM Configuration state\n",
        "  const [config, setConfig] = useState<SvmConfig>({\n",
        "    xFeature: 'medInc',\n",
        "    yFeature: 'aveRooms',\n",
        "    zFeature: 'price',\n",
        "    kernel: 'linear',\n",
        "    c: 1.0,\n",
        "    gamma: 0.8,\n",
        "    polyDegree: 2,\n",
        "    priceThreshold: 280,\n",
        "  });\n",
        "\n",
        "  // Selected point for inspector\n",
        "  const [inspectedPoint, setInspectedPoint] = useState<{\n",
        "    record: HousingRecord;\n",
        "    svInfo?: SupportVectorInfo;\n",
        "  } | null>(null);\n",
        "\n",
        "  // Prepare 2D data & run 2D SVM\n",
        "  const { points2D, xExtent2D, yExtent2D } = useMemo(() => {\n",
        "    const { points, xExtent, yExtent } = prepare2DData(\n",
        "      DEFAULT_DATASET,\n",
        "      config.xFeature,\n",
        "      config.yFeature,\n",
        "      config.priceThreshold,\n",
        "      180\n",
        "    );\n",
        "    return { points2D: points, xExtent2D: xExtent, yExtent2D: yExtent };\n",
        "  }, [config.xFeature, config.yFeature, config.priceThreshold]);\n",
        "\n",
        "  const svmResult2D = useMemo(() => {\n",
        "    return trainSVM2D(points2D, config.kernel, config.c, config.gamma, config.polyDegree);\n",
        "  }, [points2D, config.kernel, config.c, config.gamma, config.polyDegree]);\n",
        "\n",
        "  // Prepare 3D data & run 3D SVM\n",
        "  const { points3D, xExtent3D, yExtent3D, zExtent3D } = useMemo(() => {\n",
        "    const { points, xExtent, yExtent, zExtent } = prepare3DData(\n",
        "      DEFAULT_DATASET,\n",
        "      config.xFeature,\n",
        "      config.yFeature,\n",
        "      config.zFeature,\n",
        "      config.priceThreshold,\n",
        "      150\n",
        "    );\n",
        "    return { points3D: points, xExtent3D: xExtent, yExtent3D: yExtent, zExtent3D: zExtent };\n",
        "  }, [config.xFeature, config.yFeature, config.zFeature, config.priceThreshold]);\n",
        "\n",
        "  const svmResult3D = useMemo(() => {\n",
        "    return trainSVM3D(points3D, config.c);\n",
        "  }, [points3D, config.c]);\n",
        "\n",
        "  const handleUpdateConfig = (newConfig: Partial<SvmConfig>) => {\n",
        "    setConfig((prev) => ({ ...prev, ...newConfig }));\n",
        "  };\n",
        "\n",
        "  const is3D = activeTab === 'sim3d';\n",
        "  const currentAccuracy = is3D ? svmResult3D.accuracy : svmResult2D.accuracy;\n",
        "  const currentSvCount = is3D ? svmResult3D.supportVectors.length : svmResult2D.supportVectors.length;\n",
        "  const currentMargin = is3D ? svmResult3D.marginWidth : svmResult2D.marginWidth;\n",
        "  const currentTotal = is3D ? points3D.length : points2D.length;\n",
        "\n",
        "  return (\n",
        "    <div className=\"min-h-screen bg-slate-100 text-slate-900 flex flex-col font-sans selection:bg-indigo-500 selection:text-white\">\n",
        "      {/* Top Navigation Bar */}\n",
        "      <header className=\"bg-white border-b border-slate-200 sticky top-0 z-40\">\n",
        "        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n",
        "          <div className=\"flex items-center justify-between h-16\">\n",
        "            {/* Logo / Brand */}\n",
        "            <div className=\"flex items-center space-x-3\">\n",
        "              <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-slate-900 to-indigo-700 flex items-center justify-center text-white shadow-xs\">\n",
        "                <Building2 className=\"w-5 h-5\" />\n",
        "              </div>\n",
        "              <div>\n",
        "                <h1 className=\"text-base sm:text-lg font-bold text-slate-900 leading-tight\">\n",
        "                  Simulador SVM <span className=\"text-indigo-600\">Housing EE.UU.</span>\n",
        "                </h1>\n",
        "                <p className=\"text-[11px] text-slate-500 hidden sm:block\">\n",
        "                  Máquinas de Soporte Vectorial en 2D & 3D con datos de vivienda\n",
        "                </p>\n",
        "              </div>\n",
        "            </div>\n",
        "\n",
        "            {/* Navigation Tabs */}\n",
        "            <nav className=\"flex items-center space-x-1 sm:space-x-2\">\n",
        "              <button\n",
        "                id=\"nav-tab-2d\"\n",
        "                onClick={() => setActiveTab('sim2d')}\n",
        "                className={`inline-flex items-center px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors ${\n",
        "                  activeTab === 'sim2d'\n",
        "                    ? 'bg-slate-900 text-white shadow-xs'\n",
        "                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'\n",
        "                }`}\n",
        "              >\n",
        "                <Compass className=\"w-4 h-4 mr-1.5\" />\n",
        "                <span className=\"hidden xs:inline\">Simulador</span> 2D\n",
        "              </button>\n",
        "\n",
        "              <button\n",
        "                id=\"nav-tab-3d\"\n",
        "                onClick={() => setActiveTab('sim3d')}\n",
        "                className={`inline-flex items-center px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors ${\n",
        "                  activeTab === 'sim3d'\n",
        "                    ? 'bg-slate-900 text-white shadow-xs'\n",
        "                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'\n",
        "                }`}\n",
        "              >\n",
        "                <Box className=\"w-4 h-4 mr-1.5\" />\n",
        "                <span className=\"hidden xs:inline\">Espacio</span> 3D\n",
        "              </button>\n",
        "\n",
        "              <button\n",
        "                id=\"nav-tab-challenge\"\n",
        "                onClick={() => setActiveTab('challenge')}\n",
        "                className={`inline-flex items-center px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors ${\n",
        "                  activeTab === 'challenge'\n",
        "                    ? 'bg-amber-600 text-white shadow-xs'\n",
        "                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'\n",
        "                }`}\n",
        "              >\n",
        "                <Trophy className=\"w-4 h-4 mr-1.5\" />\n",
        "                Desafío Lúdico\n",
        "              </button>\n",
        "\n",
        "              <button\n",
        "                id=\"nav-tab-pedagogy\"\n",
        "                onClick={() => setActiveTab('pedagogy')}\n",
        "                className={`inline-flex items-center px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors ${\n",
        "                  activeTab === 'pedagogy'\n",
        "                    ? 'bg-indigo-600 text-white shadow-xs'\n",
        "                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'\n",
        "                }`}\n",
        "              >\n",
        "                <BookOpen className=\"w-4 h-4 mr-1.5\" />\n",
        "                Guía Didáctica\n",
        "              </button>\n",
        "            </nav>\n",
        "          </div>\n",
        "        </div>\n",
        "      </header>\n",
        "\n",
        "      {/* Main Content Viewport */}\n",
        "      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n",
        "        {/* Simulator Views (2D and 3D) */}\n",
        "        {(activeTab === 'sim2d' || activeTab === 'sim3d') && (\n",
        "          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n",
        "            {/* Visualizer Area (8 cols on lg) */}\n",
        "            <div className=\"lg:col-span-8 flex flex-col space-y-4\">\n",
        "              {activeTab === 'sim2d' ? (\n",
        "                <SvmVisualizer2D\n",
        "                  points={points2D}\n",
        "                  svmResult={svmResult2D}\n",
        "                  xKey={config.xFeature}\n",
        "                  yKey={config.yFeature}\n",
        "                  xExtent={xExtent2D}\n",
        "                  yExtent={yExtent2D}\n",
        "                  priceThreshold={config.priceThreshold}\n",
        "                  kernel={config.kernel}\n",
        "                  cValue={config.c}\n",
        "                  onSelectPoint={(record, svInfo) => setInspectedPoint({ record, svInfo })}\n",
        "                />\n",
        "              ) : (\n",
        "                <SvmVisualizer3D\n",
        "                  points={points3D}\n",
        "                  svmResult={svmResult3D}\n",
        "                  xKey={config.xFeature}\n",
        "                  yKey={config.yFeature}\n",
        "                  zKey={config.zFeature}\n",
        "                  xExtent={xExtent3D}\n",
        "                  yExtent={yExtent3D}\n",
        "                  zExtent={zExtent3D}\n",
        "                  priceThreshold={config.priceThreshold}\n",
        "                  onSelectPoint={(record, svInfo) => setInspectedPoint({ record, svInfo })}\n",
        "                />\n",
        "              )}\n",
        "\n",
        "              {/* Quick Component Explainer Banner */}\n",
        "              <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs text-xs text-slate-600 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n",
        "                <div className=\"flex items-center space-x-2\">\n",
        "                  <span className=\"p-1.5 bg-indigo-50 text-indigo-700 rounded-md\">\n",
        "                    <Sparkles className=\"w-4 h-4\" />\n",
        "                  </span>\n",
        "                  <div>\n",
        "                    <span className=\"font-semibold text-slate-800\">\n",
        "                      {activeTab === 'sim2d' ? 'Frontera 2D interactiva' : 'Hiperplano Tridimensional'}:\n",
        "                    </span>{' '}\n",
        "                    <span>\n",
        "                      {activeTab === 'sim2d'\n",
        "                        ? 'Haz clic sobre cualquier vivienda o pasa el cursor para inspeccionar sus multiplicadores α de soporte.'\n",
        "                        : 'Arrastra con el ratón para rotar el hiperplano y ver cómo separa las esferas de viviendas.'}\n",
        "                    </span>\n",
        "                  </div>\n",
        "                </div>\n",
        "                <button\n",
        "                  onClick={() => setActiveTab('pedagogy')}\n",
        "                  className=\"text-indigo-600 hover:text-indigo-800 font-semibold whitespace-nowrap text-xs flex items-center\"\n",
        "                >\n",
        "                  Ver teoría completa →\n",
        "                </button>\n",
        "              </div>\n",
        "            </div>\n",
        "\n",
        "            {/* Sidebar Controls & Parameters (4 cols on lg) */}\n",
        "            <div className=\"lg:col-span-4\">\n",
        "              <ControlsPanel\n",
        "                config={config}\n",
        "                onChangeConfig={handleUpdateConfig}\n",
        "                is3DMode={is3D}\n",
        "                accuracy={currentAccuracy}\n",
        "                svCount={currentSvCount}\n",
        "                marginWidth={currentMargin}\n",
        "                totalPoints={currentTotal}\n",
        "              />\n",
        "            </div>\n",
        "          </div>\n",
        "        )}\n",
        "\n",
        "        {/* Playful Game Mode */}\n",
        "        {activeTab === 'challenge' && (\n",
        "          <div className=\"max-w-5xl mx-auto\">\n",
        "            <ManualChallenge dataset={DEFAULT_DATASET} />\n",
        "          </div>\n",
        "        )}\n",
        "\n",
        "        {/* Pedagogical Step-by-Step Guide */}\n",
        "        {activeTab === 'pedagogy' && (\n",
        "          <div className=\"max-w-4xl mx-auto\">\n",
        "            <PedagogicalGuide />\n",
        "          </div>\n",
        "        )}\n",
        "      </main>\n",
        "\n",
        "      {/* Point Inspector Modal */}\n",
        "      {inspectedPoint && (\n",
        "        <PointInspector\n",
        "          record={inspectedPoint.record}\n",
        "          svInfo={inspectedPoint.svInfo}\n",
        "          priceThreshold={config.priceThreshold}\n",
        "          onClose={() => setInspectedPoint(null)}\n",
        "        />\n",
        "      )}\n",
        "\n",
        "      {/* Subtle Footer */}\n",
        "      <footer className=\"mt-auto bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-500\">\n",
        "        Simulador Pedagógico de Máquinas de Soporte Vectorial (SVM) • Dataset de Vivienda de California (EE.UU.)\n",
        "      </footer>\n",
        "    </div>\n",
        "  );\n",
        "}"
      ],
