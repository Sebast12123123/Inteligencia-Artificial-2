        "   \"source\": [\n",
        "    \"## 4. Separar datos de entrenamiento y de validación\\n\",\n",
        "    \"\\n\",\n",
        "    \"Si entreno y evalúo el modelo con los mismos datos, el modelo \\\"memoriza\\\" en vez de \\\"aprender\\\", y\\n\",\n",
        "    \"el error que mediría sería artificialmente bajo. Por eso separo una parte de los datos (validación)\\n\",\n",
        "    \"que el modelo nunca ve durante el entrenamiento, para medir su error de forma honesta.\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"code\",\n",
        "   \"execution_count\": 5,\n",
        "   \"id\": \"f4040847\",\n",
        "   \"metadata\": {\n",
        "    \"execution\": {\n",
        "     \"iopub.execute_input\": \"2026-09-16T12:12:24.455096Z\",\n",
        "     \"iopub.status.busy\": \"2026-09-16T12:12:24.454948Z\",\n",
        "     \"iopub.status.idle\": \"2026-09-16T12:12:25.227503Z\",\n",
        "     \"shell.execute_reply\": \"2026-09-16T12:12:25.226375Z\"\n",
        "    }\n",
        "   },\n",
        "   \"outputs\": [\n",
        "    {\n",
        "     \"name\": \"stdout\",\n",
