        "    \"    prediccion = modelo.predict(X_val)\\n\",\n",
        "    \"    # Calculo y devuelvo el MAE de esta configuración en particular\\n\",\n",
        "    \"    return mean_absolute_error(y_val, prediccion)\\n\",\n",
        "    \"\\n\",\n",
