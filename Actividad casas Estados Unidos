        "     ]\n",
        "    }\n",
        "   ],\n",
        "   \"source\": [\n",
        "    \"# Importo train_test_split, la función que me permite dividir los datos en entrenamiento y validación\\n\",\n",
        "    \"from sklearn.model_selection import train_test_split\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Divido X e y en conjuntos de entrenamiento (train) y validación (val)\\n\",\n",
        "    \"# random_state=1 lo fijo para que la división sea siempre la misma y mis resultados sean reproducibles\\n\",\n",
        "    \"X_train, X_val, y_train, y_val = train_test_split(X, y, random_state=1)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Imprimo cuántas filas quedaron en cada conjunto, para confirmar que la división se hizo correctamente\\n\",\n",
        "    \"print(\\\"Filas de entrenamiento:\\\", X_train.shape[0])\\n\",\n",
        "    \"print(\\\"Filas de validación:\\\", X_val.shape[0])\\n\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"markdown\",\n",
        "   \"id\": \"53432cf6\",\n",
        "   \"metadata\": {},\n",
        "   \"source\": [\n",
        "    \"## 5. Modelo 1: Árbol de Decisión (`DecisionTreeRegressor`)\\n\",\n",
        "    \"\\n\",\n",
        "    \"Empiezo con un árbol de decisión porque es el modelo del ejemplo de referencia de Kaggle.\\n\",\n",
        "    \"Un árbol de decisión va haciendo preguntas tipo \\\"¿el área es mayor a X?\\\" y va dividiendo los\\n\",\n",
        "    \"datos en grupos cada vez más parecidos entre sí, hasta llegar a una predicción final por grupo (hoja).\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"code\",\n",
        "   \"execution_count\": 6,\n",
        "   \"id\": \"15c84729\",\n",
        "   \"metadata\": {\n",
        "    \"execution\": {\n",
        "     \"iopub.execute_input\": \"2026-09-16T12:12:25.229624Z\",\n",
        "     \"iopub.status.busy\": \"2026-09-16T12:12:25.229019Z\",\n",
        "     \"iopub.status.idle\": \"2026-09-16T12:12:25.292232Z\",\n",
        "     \"shell.execute_reply\": \"2026-09-16T12:12:25.291115Z\"\n",
        "    }\n",
        "   },\n",
        "   \"outputs\": [\n",
        "    {\n",
        "     \"name\": \"stdout\",\n",
        "     \"output_type\": \"stream\",\n",
        "     \"text\": [\n",
        "      \"Arbol de Decision -> MAE: 29,653 | RMSE: 41,781 | R2: 0.7400\\n\"\n",
        "     ]\n",
        "    }\n",
        "   ],\n",
        "   \"source\": [\n",
        "    \"# Importo la clase del modelo de árbol de decisión para regresión (predice un número, no una categoría)\\n\",\n",
        "    \"from sklearn.tree import DecisionTreeRegressor\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Importo las métricas que voy a usar para medir qué tan bien predice cada modelo\\n\",\n",
        "    \"from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Creo el modelo de árbol; random_state=1 asegura que, si hay algo aleatorio internamente, sea reproducible\\n\",\n",
        "    \"modelo_arbol = DecisionTreeRegressor(random_state=1)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Entreno el árbol: aquí es donde el modelo \\\"aprende\\\" los patrones a partir de X_train y y_train\\n\",\n",
        "    \"modelo_arbol.fit(X_train, y_train)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Uso el modelo ya entrenado para predecir el precio de las casas del conjunto de validación (que no vio antes)\\n\",\n",
        "    \"pred_arbol = modelo_arbol.predict(X_val)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Calculo el MAE (error absoluto medio): en promedio, ¿cuántos dólares me equivoco por casa?\\n\",\n",
        "    \"mae_arbol = mean_absolute_error(y_val, pred_arbol)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Calculo el RMSE (raíz del error cuadrático medio): parecido al MAE, pero penaliza más los errores grandes\\n\",\n",
        "    \"rmse_arbol = np.sqrt(mean_squared_error(y_val, pred_arbol))\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Calculo el R² (qué tan bien explica el modelo la variabilidad del precio); 1 es perfecto, 0 es no explica nada\\n\",\n",
        "    \"r2_arbol = r2_score(y_val, pred_arbol)\\n\",\n",
        "    \"\\n\",\n",
        "    \"# Imprimo los tres resultados juntos para tener una foto rápida del rendimiento del árbol\\n\",\n",
        "    \"print(f\\\"Arbol de Decision -> MAE: {mae_arbol:,.0f} | RMSE: {rmse_arbol:,.0f} | R2: {r2_arbol:.4f}\\\")\\n\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"markdown\",\n",
        "   \"id\": \"e76d28da\",\n",
        "   \"metadata\": {},\n",
        "   \"source\": [\n",
        "    \"### 5.1. Ajustando la profundidad del árbol\\n\",\n",
        "    \"\\n\",\n",
        "    \"Un árbol de decisión sin límites puede crecer demasiado y \\\"memorizar\\\" el set de entrenamiento\\n\",\n",
        "    \"(overfitting). Para evitarlo, controlo `max_leaf_nodes` (cantidad máxima de hojas finales) y\\n\",\n",
        "    \"pruebo distintos valores para encontrar un punto intermedio entre un árbol muy simple (que no\\n\",\n",
        "    \"aprende lo suficiente, *underfitting*) y uno muy complejo (que memoriza, *overfitting*).\"\n",
        "   ]\n",
